# Copy to .env.local (git-ignored) and fill in.

# Gemini API key from https://aistudio.google.com/apikey
# Use a paid-tier key: free-tier requests may be used to improve Google products.
# Free-tier transcription is capped at 25 requests/day (per model).
GEMINI_API_KEY=

# Optional: override the transcription model (it's a Preview model and may change).
# GEMINI_MODEL=gemini-3.5-transcribe
# Text model for "smart spelling" (English letters + English words restored).
# GEMINI_SPELL_MODEL=gemini-3.5-flash-lite

# App-wide usage limits (defaults shown). There's no login yet, so these are
# what cap Gemini spend if the app is deployed publicly.
# QUOTA_MINUTES_PER_DAY=120
# RATE_LIMIT_PER_MINUTE=20
# MAX_CHUNK_SECONDS=600

# Upstash Redis for quotas/rate limits that work across serverless instances.
# Without these, an in-memory store is used (fine for local dev only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

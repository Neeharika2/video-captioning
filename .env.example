# Copy to .env.local (git-ignored) and fill in.

# The app has no shared Gemini key: each visitor pastes their own key in
# Settings, it is stored in their browser, and it is forwarded to Google per
# request. GEMINI_API_KEY below is only used by the benchmark and the optional
# real e2e test (E2E_REAL=1) — it is never used to serve app traffic.
# Free-tier keys allow 25 transcription requests/day (per model).
# GEMINI_API_KEY=

# Optional: override the transcription model (it's a Preview model and may change).
# GEMINI_MODEL=gemini-3.5-transcribe
# Text model for "smart spelling" (English letters + English words restored).
# GEMINI_SPELL_MODEL=gemini-3.5-flash-lite

# Request-rate limits (defaults shown), applied per visitor key and endpoint.
# Spend belongs to each visitor's own key, so there is no shared daily budget.
# RATE_LIMIT_PER_MINUTE=20
# MAX_CHUNK_SECONDS=600
# MAX_UPLOAD_BYTES=4400000

# Upstash Redis for rate limits that work across serverless instances.
# Without these, an in-memory store is used (fine for local dev only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
